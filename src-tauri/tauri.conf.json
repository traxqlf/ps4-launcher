{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ps4-launcher",
  "version": "0.1.0",
  "identifier": "com.thibault.ps4-launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ps4-launcher",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/themes/**",
          "$APPDATA/avatar.png",
          "$APPDATA/avatar.jpg",
          "$APPDATA/avatar.webp"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ1OTJGMDczRkQ3MEQ3MTUKUldRVjEzRDljL0NTUmVrQU16OWpPd3JkVm5pQXFncHJPVXpPSHB4L2Y1UjRkL2R4L05WbVhzdjYK",
      "endpoints": [
        "https://github.com/traxqlf/ps4-launcher/releases/latest/download/latest.json"
      ]
    }
  }
}
